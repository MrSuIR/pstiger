/* Программа реализует поиск простых чисел, не превышающих заданного числа N, с помощью решета Эратосфена. */
let
  /* Ищет максимальное число, не превышающее квадратный корень натурального числа,
    с помощью бинарного поиска. */
  function sqrtFloor(n: int): int =
    if n <= 0
    then
      0
    else
      let
        var left := 1
        var right := n
        var mid := 0
      in
        while right > left + 1 do (
          mid := (left + right) / 2;
          if mid * mid > n
          then
            right := mid
          else
            left := mid
        );
        left
      end

  /*
   Преобразует строку к 32-битному целому числу:
     1) Преобразование выполняется с учётом возможного знака "-" или "+"
     2) Преобразование выполняется до первого символа, не являющегося цифрой
     3) Если число выходит за пределы диапазона 32-битных целых чисел, то,
        в зависимости от знака, будет возвращено максимальное либо минимальное целое число
   */
  function stringToInt(input: string): int =
    let
      var length := size(input)
      var index := 0
      var sign := 1
      var modulo := 0
      var digit := 0
      var zero := ord("0")
      var nine := ord("9")
      var maxInt := 2147483647
      var minInt := (-2147483647 - 1)
      var result := 0
    in
      if length = 0
      then
        0
      else (
        if substring(input, 0, 1) = "-"
        then (
          sign := -1;
          index := 1
        )
        else if substring(input, 0, 1) = "+"
        then
          index := 1;
        while (index < length) do (
          digit := ord(substring(input, index, 1));
          index := index + 1;
          if digit < zero | digit > nine
          then
            break;
          if modulo > maxInt / 10 | modulo = maxInt / 10 & (digit - zero) > 7
          then (
            result := if sign = 1 then maxInt else minInt;
            break
          );
          modulo := 10 * modulo + (digit - zero);
          result := sign * modulo
        );
        result
      )
    end

  /*
   Читает одну строку, пока не встретится символ "\n" либо конец файла
   */
  function readLine(): string =
    let
      var result := ""
      var char := ""
    in
      while 1 do (
        char := getchar();
        if char = "" | char = "\n" then
          break;
        result := concat(result, char)
      );
      result
    end

  /* Тип, представляющий массив целых чисел без указания размера */
  type IntArrayData = array of int
  
  /* Тип, представляющий массив целых чисел с указанием размера */
  type IntArray = { size: int, data: IntArrayData }

  /* Создаёт новый массив целых чисел указанного размера, заполняя указанным значением */  
  function newIntArray(size: int, value: int): IntArray = IntArray{
    size = size,
    data = IntArrayData[size] of value
  }
  
  /* Печатает массив целых чисел в квадратных скобках, разделяя элементы через запятую */
  function printIntArray(numbers: IntArray) = (
    print("[");
    if numbers.size > 0 then (
      printi(numbers.data[0]);
      for i := 1 to numbers.size - 1 do (
        print(", ");
        printi(numbers.data[i])
      )
    );
    print("]")
  )

  /* Возвращает массив простых чисел, не превышающих число n. */
  function listPrimesUpTo(n: int): IntArray =
    let
      var sieve := IntArrayData[n] of 1
      var primesCount := 0
      var nSquareRoot := sqrtFloor(n)
      var multiple := 0
    in
      /*
        Оптимизация решета Эратосфена: вычёркиваем числа из решета только для множителей, не превышающих
        квадратный корень из n. Остальные множители уже не смогут сформировать составные числа, не превышающие n.
       */
       for candidate := 2 to nSquareRoot do (
         if sieve[candidate - 1] = 1 then (
           primesCount := primesCount + 1;
           multiple := candidate * candidate;
           while multiple <= n do (
             sieve[multiple - 1] := 0;
             multiple := multiple + candidate
           )
         )
       );
       
       /* Считаем количество простых чисел, оставшихся в решете */
       for candidate := nSquareRoot + 1 to n do (
         if sieve[candidate - 1] = 1
         then
            primesCount := primesCount + 1
       );
       
       /* Создаём массив простых чисел, оставшихся в решете */
       let
         var primes := newIntArray(primesCount, 0)
         var primeIndex := 0
       in
         for candidate := 2 to n do (
           if sieve[candidate - 1] = 1 then (
             primes.data[primeIndex] := candidate;
             primeIndex := primeIndex + 1
           )
         );
         primes
       end
    end
in
  printIntArray(listPrimesUpTo(stringToInt(readLine())))
end