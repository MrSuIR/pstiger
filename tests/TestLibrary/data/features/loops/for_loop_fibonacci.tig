/*
 * Программа выводит первые 12 чисел Фиббоначи, начиная с 0.
 * При этом цикл:
 *  1) обращается к переменным внешней области видимости;
 *  2) содержит внутреннюю область видимости.
 */
let
    var curr := 0
    var next := 1
in
    for i := 0 to 11 do (
        printi(curr);
        print(";");
        let
          var tmp := curr
        in
            curr := next;
            next := tmp + next
        end
    )
end