/* массивы сравниваются их по ссылке, а не по значениям элементов */
let
    type intArray = array of int
    var numsCount := 2
    var nums1: intArray := intArray[numsCount] of 3
    var nums2: intArray := intArray[numsCount] of 3
in
    printi(nums1 = nums2);
    printi(nums2 = nums1);
    printi(nums1 = nums1);
    printi(nums2 = nums2);
    print(" ");
    printi(nums1 <> nums2);
    printi(nums2 <> nums1);
    printi(nums1 <> nums1);
    printi(nums2 <> nums2)
end