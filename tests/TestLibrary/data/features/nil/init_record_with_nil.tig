/*
 можно инициализировать переменную значением nil с указанием типа структуры `var a: record := nil
 */
let
    type Point = { x: int, y: int }
    function printPoint(p: Point) = (
        printi(p.x);
        print(", ");
        printi(p.y)
    )
    var point: Point := nil
in
    point := Point{ x = 10, y = 12 };
    printPoint(point)
end