/* Программа содержит все операторы сравнения целых чисел */
(
    print("1 + 2 < 5 = ");
    printi(1 + 2 < 5);
    print("\n");
    print("2 * 2 > 5 = ");
    printi(2 * 2 > 5);
    print("\n");
    print("2 * 2 = 5 = ");
    printi(2 * 2 = 5);
    print("\n");
    print("2 / 2 <> 4 = ");
    printi(2 / 2 <> 4);
    print("\n");
    print("2 * 2 >= 4 = ");
    printi(2 * 2 >= 4);
    print("\n");
    print("2 - 1 <= 1 = ");
    printi(2 - 1 <= 1);
    print("\n");
    print("1 = (2 = 3) = ");
    printi(1 = (2 = 3))
)

